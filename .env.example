# Postgres. On Neon or Vercel Postgres, use the pooled URL here and the
# direct (non-pooling) URL as DIRECT_URL. Prisma migrations need the direct URL.
# Vercel Storage names these POSTGRES_PRISMA_URL and POSTGRES_URL_NON_POOLING.
# Copy those values into the two variables below. The app does not read the
# Vercel names itself.
DATABASE_URL="postgresql://ptg:ptg@localhost:5432/ptg?schema=public"
DIRECT_URL="postgresql://ptg:ptg@localhost:5432/ptg?schema=public"

# Auth.js session signing. Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"
# Public origin, no trailing slash. Local: http://127.0.0.1:3847
# Production: https://your-domain.vercel.app
AUTH_URL="http://127.0.0.1:3847"

# Vercel Cron sends Authorization: Bearer $CRON_SECRET to /api/cron/publish.
CRON_SECRET="replace-with-a-long-random-string"

# Vercel Blob read/write token from the Blob store connected to the project.
# Leave empty locally. Uploads then save to public/uploads and are not
# reachable by Instagram.
BLOB_READ_WRITE_TOKEN=""

# Meta app (developers.facebook.com). Required before Connect Instagram works.
# Leave empty to use the desk without publishing.
META_APP_ID=""
META_APP_SECRET=""
# Optional. Defaults to ${AUTH_URL}/api/instagram/callback
META_REDIRECT_URI=""
# Optional. Graph API version used for OAuth and publishing.
META_GRAPH_VERSION="v22.0"

# Professional account to prefer when the Facebook user admins more than one Page.
INSTAGRAM_USERNAME="preachthegospel.store"
# live calls the Graph API. dry-run logs the attempt and leaves the post scheduled.
INSTAGRAM_PUBLISH_MODE="live"

# First owner created by prisma db seed. Change the password after the first login.
SEED_OWNER_EMAIL="mike@preachthegospel.store"
SEED_OWNER_NAME="Mike"
SEED_OWNER_PASSWORD="change-me"

# Shows the seed email and password on the login screen. Keep false in production.
SHOW_DEMO_LOGIN="false"
